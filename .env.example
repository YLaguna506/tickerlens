# Copy to .env and fill in (`task up` does the copy for you if .env is missing).
# .env is git-ignored. Never commit real keys.

# --- Data providers ---------------------------------------------------------
# SEC EDGAR needs no key, but every request must identify you.
SEC_USER_AGENT=TickerLens you@example.com
TIINGO_API_KEY=
ALPHA_VANTAGE_API_KEY=

# --- LLM ----------------------------------------------------------------------
# gemini (fast, free tier), openrouter (many models, some free) or openai.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-3.5-flash
OPENROUTER_API_KEY=
OPENROUTER_LLM_MODEL=
OPENAI_API_KEY=
# Optional overrides; empty means the provider's <PROVIDER>_LLM_MODEL above.
# The model must support JSON-schema responses.
LLM_MODEL_FAST=
LLM_MODEL_STRONG=
# Used when the main model keeps answering "overloaded" or "over quota".
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite
# Extra models for the model switcher ("provider:model, ..."). The switcher
# already lists the default model, the fallback, and <PROVIDER>_LLM_MODEL for
# every provider whose key is set.
LLM_MODEL_CHOICES=
LLM_REASONING_EFFORT=low
# How many AI agents run at once (empty = all three). Free tiers have
# per-minute quotas, so 1 is safest there.
AGENT_CONCURRENCY=1
LLM_JOB_COST_CAP_USD=0.25

# --- Infrastructure (defaults match docker-compose.yml) ---------------------
POSTGRES_USER=tickerlens
POSTGRES_PASSWORD=tickerlens
POSTGRES_DB=tickerlens
DATABASE_URL=postgres://tickerlens:tickerlens@postgres:5432/tickerlens?sslmode=disable
AGENTS_URL=http://agents:8000

# --- Host ports (change if something on your machine already uses one) ------
API_PORT=8080
AGENTS_PORT=8000
WEB_PORT=3000
POSTGRES_PORT=5432
