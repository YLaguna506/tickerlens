# Normalize line endings to LF in the repo and working tree so files behave
# the same in Docker (Linux) and on Windows.
* text=auto eol=lf

*.sh  text eol=lf
*.go  text eol=lf
*.py  text eol=lf

# Windows-only scripts keep CRLF.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

*.png  binary
*.jpg  binary
*.gif  binary
*.ico  binary
*.woff2 binary
